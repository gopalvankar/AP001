        {
            "id": "11111111-1111-1111-1111-111111111110",
            "name": "SLA Configuration Note",
            "type": "n8n-nodes-base.stickyNote",
            "typeVersion": 1,
            "position": [
                680,
                160
            ],
            "parameters": {
                "content": "## SLA & Routing Configuration\nThis Code node contains hardcoded routing policy.\n- **HIGH_VALUE_THRESHOLD**: 50,000 EUR — applications above this get HIGH priority\n- **STANDARD_REVIEW_DAYS**: 3 days SLA for standard applications\n- **HIGH_VALUE_REVIEW_DAYS**: 5 days SLA for high-value applications\n\nUpdate the values in the Code node when policy changes.",
                "height": 140,
                "width": 320
            }
        },
        {
            "id": "c3d4e5f6-a7b8-9012-cdef-123456789012",
            "name": "Route By Grant Value",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                680,
                300
            ],
            "parameters": {
                "mode": "runOnceForEachItem",
                "language": "javaScript",
                "jsCode": "// ─── SLA & ROUTING CONFIGURATION ───────────────────────────────────────────\n// This configuration is hardcoded — the values below reflect current policy.\n// If routing thresholds or SLA days change, update the values in this block.\n// Replace with a live lookup when dynamic policy management is available.\nconst SLA_CONFIG = {\n  HIGH_VALUE_THRESHOLD: 50000,\n  STANDARD_REVIEW_DAYS: 3,\n  HIGH_VALUE_REVIEW_DAYS: 5,\n  ADMIN_EMAIL: \"gopalchandra.vankar@sap.com\"\n};\n// ────────────────────────────────────────────────────────────────────────────\n\nconst requestedAmount = parseFloat($input.item.json.requestedAmount || 0);\nconst isHighValue = requestedAmount > SLA_CONFIG.HIGH_VALUE_THRESHOLD;\nconst reviewDays = isHighValue ? SLA_CONFIG.HIGH_VALUE_REVIEW_DAYS : SLA_CONFIG.STANDARD_REVIEW_DAYS;\n\nconst deadline = new Date();\ndeadline.setDate(deadline.getDate() + reviewDays);\n\nreturn {\n  json: {\n    ...$input.item.json,\n    grantTier: isHighValue ? 'high_value' : 'standard',\n    slaDeadline: deadline.toISOString(),\n    adminEmail: SLA_CONFIG.ADMIN_EMAIL\n  }\n};"
            }
        },
        {
            "id": "d4e5f6a7-b8c9-0123-defa-234567890123",
            "name": "Check Grant Tier",
            "type": "n8n-nodes-base.if",
            "typeVersion": 2.3,
            "position": [
                900,
                300
            ],
            "parameters": {
                "conditions": {
                    "options": {
                        "caseSensitive": true,
                        "leftValue": "",
                        "typeValidation": "strict"
                    },
                    "conditions": [
                        {
                            "id": "tier-check-1",
                            "leftValue": "={{ $json.grantTier }}",
                            "rightValue": "high_value",
                            "operator": {
                                "type": "string",
                                "operation": "equals"
                            }
                        }
                    ],
                    "combinator": "and"
                },
                "options": {}
            }
        },
